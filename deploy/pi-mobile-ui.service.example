[Unit]
Description=Pi Mobile UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/YOUR_PROJECT
ExecStart=/home/YOUR_USER/.local/bin/pi-mobile-ui
Environment=PI_MOBILE_HOST=127.0.0.1
Environment=PI_MOBILE_PORT=3003
Environment=PI_MOBILE_CWD=/home/YOUR_USER/YOUR_PROJECT
Environment=PI_MOBILE_PI=/home/YOUR_USER/.local/bin/pi
Environment=PI_CODING_AGENT_DIR=/home/YOUR_USER/.pi/agent
Environment=RUST_LOG=pi_mobile_ui=info
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

